# BytePlus ModelArk (video generation - Seedance 2.0)
ARK_API_KEY=ark-REPLACE-WITH-YOUR-KEY
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_MODEL_ID=dreamina-seedance-2-0-260128

# Seed Audio 1.0 (voice/audio generation) — SEPARATE BytePlus Voice service.
# Activate "Dola_SeedSpeech_Seed_Audio_V1" at
#   https://console.byteplus.com/voice/new/setting/activate
# then paste that console's API Key here (this is the X-Api-Key header — it is
# NOT the same as ARK_API_KEY above).
SEED_AUDIO_API_KEY=REPLACE-WITH-VOICE-CONSOLE-API-KEY
SEED_AUDIO_URL=https://voice.ap-southeast-1.bytepluses.com/api/v3/tts/create
SEED_AUDIO_MODEL_ID=seed-audio-1.0
# Legacy two-header auth (only if you use the old console instead of X-Api-Key):
# SEED_AUDIO_APP_ID=
# SEED_AUDIO_ACCESS_KEY=

# Anthropic Claude API (for cloud deployment — replaces Chrome CDP)
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6

# Backend selector: "api" (cloud, needs ANTHROPIC_API_KEY), "chrome" (local CDP), "auto"
LLM_BACKEND=auto

# Chrome CDP (local only)
CDP_PORT=9224

# Skill APIs
GEMINI_API_KEY=AIzaSy-REPLACE-WITH-YOUR-KEY
TAVILY_API_KEY=tvly-dev-REPLACE-WITH-YOUR-KEY
SCRAPECREATORS_API_KEY=REPLACE-WITH-YOUR-KEY
IMGBB_API_KEY=REPLACE-WITH-YOUR-KEY

DEFAULT_OUTPUT_DIR=./outputs/videos
