# BytePlus ModelArk (video generation - Seedance 2.0)
ARK_API_KEY=ark-REPLACE-WITH-YOUR-KEY
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_MODEL_ID=dreamina-seedance-2-0-260128

# Anthropic Claude API (for cloud deployment — replaces Chrome CDP)
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6

# Backend selector: "api" (cloud, needs ANTHROPIC_API_KEY), "chrome" (local CDP), "auto"
LLM_BACKEND=auto

# Chrome CDP (local only)
CDP_PORT=9224

# Skill APIs
GEMINI_API_KEY=AIzaSy-REPLACE-WITH-YOUR-KEY
TAVILY_API_KEY=tvly-dev-REPLACE-WITH-YOUR-KEY
SCRAPECREATORS_API_KEY=REPLACE-WITH-YOUR-KEY
IMGBB_API_KEY=REPLACE-WITH-YOUR-KEY

DEFAULT_OUTPUT_DIR=./outputs/videos
